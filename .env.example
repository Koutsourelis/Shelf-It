# Αντίγραψε αυτό το αρχείο σε ".env" και συμπλήρωσε. Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub.

# --- Μοντέλο: anthropic | openai_compat | mock (το mock δουλεύει χωρίς κλειδί και χωρίς internet)
LLM_PROVIDER=mock

# Claude (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 = φθηνό για ανάπτυξη · claude-opus-5-5 = ισχυρό για το demo
ANTHROPIC_MODEL=claude-haiku-5-5

# Οποιοσδήποτε πάροχος με API τύπου OpenAI. Παραδείγματα base url:
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      (άφησέ το κενό)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Σετ δεδομένων: κενό = data/shelf (ράφι καφέ) · trad = data/shelf/sets/trad (πραγματική φωτογραφία)
# Ισχύει για server, make_demo_data, eval_vision. Δεύτερη βάση: data/demo_<set>.duckdb
SHELF_SET=

# --- Όραση (Gemini μέσω openai_compat: LLM_PROVIDER=openai_compat, base url της Google, OPENAI_COMPAT_MODEL=<id από το AI Studio>)
# Φωτογραφία του σωστού ραφιού που στέλνεται μαζί με κάθε frame, π.χ. data/shelf/refs/shelf_ok.jpg. Κενό = χωρίς.
VISION_REFERENCE=
VISION_TIMEOUT_SECONDS=40
# Native Gemini για την όραση (response schema από το API, πιο αξιόπιστοι τύποι από το openai_compat):
#   VISION_PROVIDER=gemini   · κενό = ό,τι ορίζει το LLM_PROVIDER
# Ο agent συνεχίζει με το LLM_PROVIDER. Αν το OPENAI_COMPAT_* δείχνει ήδη στη Google, το κλειδί και το μοντέλο
# παίρνονται από εκεί και τα δύο παρακάτω μένουν κενά.
VISION_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# κενό = προεπιλογή του μοντέλου · low | medium | high (high = περισσότερη λεπτομέρεια, πιο αργό και ακριβό)
GEMINI_MEDIA_RESOLUTION=
# 0 = προεπιλογή του μοντέλου
GEMINI_MAX_OUTPUT_TOKENS=0
# low = γρήγορο (ζωντανή κάμερα) · medium/high = πιο προσεκτικό, αργό. Το «minimal» δεν υποστηρίζεται.
GEMINI_THINKING_LEVEL=low
# μέγιστη πλευρά της εικόνας (pixel) που στέλνεται στο Gemini
VISION_MAX_IMAGE_SIDE=1600

# --- Live παρακολούθηση (σελίδα /shelf)
LIVE_INTERVAL_SECONDS=30
# ίδια ευρήματα σε τόσα συνεχόμενα frames → αναφορά στον αποθηκάριο
LIVE_CONFIRM_FRAMES=2
# frame σχεδόν ίδιο με το προηγούμενο (μέση διαφορά pixel 0-255) → δεν καλείται το μοντέλο
LIVE_DIFF_THRESHOLD=4.0
# 1 = νέα ευρήματα ξεκινούν και τον agent στο /dev, για εξήγηση και πρόταση διάταξης (οι εργασίες βγαίνουν χωρίς αυτόν)
LIVE_START_AGENT=1
# Πάνω από αυτό το ποσοστό άγνωστων προϊόντων το ράφι θεωρείται άλλου τμήματος: αξιολόγηση χωρίς
# κατάλογο (καμία παραγγελία, μόνο παρατηρήσεις και πρόταση διάταξης)
LIVE_UNKNOWN_RATIO=0.6

# --- Αυτονομία: παραγγελίες χωρίς έγκριση μέσα σε όρια (agentkit/tasks.py)
AUTO_ORDER=1
AUTO_ORDER_MAX_CASES=3
AUTO_ORDER_MAX_EUR=50
# υπενθύμιση για εργασία που μένει ανοιχτή τόσα λεπτά · 0 = ποτέ
TASK_REMINDER_MINUTES=10

# --- Συμπεριφορά
DEFAULT_SCENARIO=shelf
MAX_STEPS=30
# 1 = οι ενέργειες προς τα έξω (παραγγελία, email) εκτελούνται χωρίς ερώτηση
AUTO_APPROVE=0
WATCHERS_ENABLED=1
WATCH_INTERVAL_SECONDS=20
# 0 = φαίνεται το παράθυρο του browser την ώρα που δουλεύει ο agent
BROWSER_HEADLESS=1

# --- Telegram (προαιρετικό): φτιάξε bot με τον @BotFather και βάλε εδώ το token
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# --- Email (προαιρετικό): χωρίς αυτά, τα email γράφονται στο workspace/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Τεκμήρια από το διαδίκτυο (προαιρετικό): χωρίς token treg η αναζήτηση γίνεται με DuckDuckGo
TREG_TOKEN=
TREG_ORG=
# Εργαλεία του treg (άφησέ τα όπως είναι, εκτός αν αλλάξουμε πάροχο)
TREG_SEARCH_TOOL=treg.web.search
TREG_NEWS_TOOL=treg.web.search.news
TREG_TRENDS_TOOL=treg.google.keywords.trends
TREG_QUERY_PARAM=q
TREG_TRENDS_EXTRA=
EVIDENCE_REGION=Ελλάδα
EVIDENCE_MIN_SOURCES=2

# --- Ταυτότητα του project: όνομα, σύνθημα και λογότυπο (αρχείο μέσα στο console/, π.χ. logo.png)
PROJECT_NAME=ShelfSense
PROJECT_TAGLINE=Από μια φωτογραφία ραφιού σε γεμάτο, σωστό ράφι
PROJECT_LOGO=

# 0.0.0.0 = το κινητό βλέπει τον server στο ίδιο δίκτυο (χρειάζεται για το QR στην αρχική).
# Άφησέ το 127.0.0.1 μόνο όταν δουλεύεις μόνο στο laptop.
HOST=0.0.0.0
PORT=8000
# διεύθυνση από tunnel για το κινητό, π.χ. https://xxxx.trycloudflare.com · κενό = η IP του laptop
PUBLIC_URL=
