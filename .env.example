# Αντίγραψε αυτό το αρχείο σε ".env" και συμπλήρωσε. Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub.

# --- Μοντέλο: anthropic | openai_compat | mock (το mock δουλεύει χωρίς κλειδί και χωρίς internet)
LLM_PROVIDER=mock

# Claude (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 = φθηνό για ανάπτυξη · claude-opus-5-5 = ισχυρό για το demo
ANTHROPIC_MODEL=claude-haiku-5-5

# Οποιοσδήποτε πάροχος με API τύπου OpenAI. Παραδείγματα base url:
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      (άφησέ το κενό)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Όραση (Gemini μέσω openai_compat: LLM_PROVIDER=openai_compat, base url της Google, OPENAI_COMPAT_MODEL=<id από το AI Studio>)
# Φωτογραφία του σωστού ραφιού που στέλνεται μαζί με κάθε frame, π.χ. data/shelf/refs/shelf_ok.jpg. Κενό = χωρίς.
VISION_REFERENCE=
VISION_TIMEOUT_SECONDS=40

# --- Live παρακολούθηση (σελίδα /live)
LIVE_INTERVAL_SECONDS=30
# ίδια ευρήματα σε τόσα συνεχόμενα frames → αναφορά στον αποθηκάριο
LIVE_CONFIRM_FRAMES=2
# frame σχεδόν ίδιο με το προηγούμενο (μέση διαφορά pixel 0-255) → δεν καλείται το μοντέλο
LIVE_DIFF_THRESHOLD=4.0
# 1 = νέα ευρήματα ξεκινούν πλήρη εκτέλεση του agent (αναπλήρωση, παραγγελία, αναφορά)
LIVE_START_AGENT=1

# --- Συμπεριφορά
DEFAULT_SCENARIO=shelf
MAX_STEPS=30
# 1 = οι ενέργειες προς τα έξω (παραγγελία, email) εκτελούνται χωρίς ερώτηση
AUTO_APPROVE=0
WATCHERS_ENABLED=1
WATCH_INTERVAL_SECONDS=20
# 0 = φαίνεται το παράθυρο του browser την ώρα που δουλεύει ο agent
BROWSER_HEADLESS=1

# --- Telegram (προαιρετικό): φτιάξε bot με τον @BotFather και βάλε εδώ το token
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# --- Email (προαιρετικό): χωρίς αυτά, τα email γράφονται στο workspace/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Ταυτότητα του project: όνομα, σύνθημα και λογότυπο (αρχείο μέσα στο console/, π.χ. logo.png)
PROJECT_NAME=ShelfSense
PROJECT_TAGLINE=Από μια φωτογραφία ραφιού σε γεμάτο, σωστό ράφι
PROJECT_LOGO=

HOST=127.0.0.1
PORT=8000
